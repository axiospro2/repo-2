# DynamoDB local (via docker-compose) — boto3 lê AWS_ENDPOINT_URL_DYNAMODB nativamente,
# não precisa de nenhuma mudança de código na app.
AWS_ENDPOINT_URL_DYNAMODB=http://localhost:8010
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
AWS_DEFAULT_REGION=us-east-1
TABELA_FATURAMENTO=tbcv4163_fatm_cogl_subg

# Serviços externos — apontando pro mock-api (docker-compose, porta 8080)
NJ6_BASE_URL=http://localhost:8080
ENDPOINT_BASE_URL=http://localhost:8080
INTEG_TIMEOUT_S=5

# Auth M2M (OAuth2 client_credentials) — apontando pro mock-api
TOKEN_URL=http://localhost:8080/oauth/token
AUTH_CLIENT_ID=local-client
AUTH_CLIENT_SECRET=local-secret
ITAU_API_KEY=local-api-key

# Serviço de parâmetros — QuickConfig (lib interna `manager`, não REST/mock-api).
# Sem cluster local pra conectar: deixe QUICKCONFIG_CLUSTER_MEMBERS vazio/comentado
# de propósito — sem cluster, o adapter cai direto no fallback hardcoded (6 faixas,
# BRL/USD, 30% de limite de divergência). Rodar o uvicorn local exige o stub de
# dev em dev-stubs/manager (ver SETUP.md) — sem ele o import de `manager` quebra.
# QUICKCONFIG_CLUSTER_MEMBERS=host1:5701,host2:5701
# QUICKCONFIG_APP_NAME=Faturamento-irb-lambda
# QUICKCONFIG_TTL_S=300
# QUICKCONFIG_KEY_FAIXAS=catalogo-faixas
# QUICKCONFIG_KEY_MOEDAS=catalogo-moedas
# QUICKCONFIG_KEY_LIMITE_DIVERGENCIA=limite-Maximo-Divergencia-Porcentagem

# SSL (opcional, deixar vazio em local dev)
# SSL_CERT_FILE=/path/to/cert.pem
# SSL_CERT_DIR=/path/to/certs/
