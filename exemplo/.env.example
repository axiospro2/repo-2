# Copie para .env e preencha. Nunca commitar o .env real (já está no .gitignore).

# Obrigatórias
AUTH_TOKEN_URL=https://auth.example.com/token
AUTH_CLIENT_ID=changeme
AUTH_CLIENT_SECRET=changeme

# Um dos dois define a URL da API interna (INTERNAL_API_BASE_URL tem prioridade)
API_DNS=example.com
# INTERNAL_API_BASE_URL=https://internal.example.com/irb-cra-faturamento/v1

